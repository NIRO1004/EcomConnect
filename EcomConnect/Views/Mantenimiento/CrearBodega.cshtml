@{
    ViewData["Title"] = "Registrar bodega";
}

<div class="container py-4">
    <h2>Registrar bodega</h2>
    <p class="text-muted">Complete los datos de la nueva bodega.</p>

    <form asp-controller="Mantenimiento"
          asp-action="CrearBodega"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label for="Nombre" class="form-label">Nombre</label>
            <input type="text" id="Nombre" name="Nombre"
                   class="form-control" maxlength="200" required />
        </div>

        <div class="mb-3">
            <label for="Ubicacion" class="form-label">Ubicación</label>
            <input type="text" id="Ubicacion" name="Ubicacion"
                   class="form-control" maxlength="200" required />
        </div>

        <div class="mb-3">
            <label for="TiempoProcesamientoHoras" class="form-label">
                Tiempo de procesamiento (horas)
            </label>
            <input type="number" id="TiempoProcesamientoHoras"
                   name="TiempoProcesamientoHoras"
                   class="form-control" min="0" required />
        </div>

        <button type="submit" class="btn btn-primary">
            Registrar bodega
        </button>

        <a asp-controller="Mantenimiento"
           asp-action="ProductosBodegas"
           class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
