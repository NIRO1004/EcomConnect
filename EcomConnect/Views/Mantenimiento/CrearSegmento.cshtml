@using EcomConnect.Models

@{
    ViewData["Title"] = "Crear segmento";
    var clientes = ViewBag.Clientes as List<Cliente>
        ?? new List<Cliente>();
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h2 class="fw-bold" style="color: #0284c7;">
            Crear segmento
        </h2>

        <a asp-controller="Mantenimiento"
           asp-action="GestionSegmentos"
           class="btn btn-outline-secondary">
            Volver
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <p class="text-muted">
                Registre una clasificación y asígnela a un cliente existente.
            </p>

            <form asp-action="CrearSegmento" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label for="Nombre" class="form-label">
                        Nombre del segmento
                    </label>
                    <input id="Nombre" name="Nombre"
                           class="form-control" maxlength="500"
                           required />
                </div>

                <div class="mb-3">
                    <label for="DescripcionSegmento" class="form-label">
                        Descripción
                    </label>
                    <textarea id="DescripcionSegmento"
                              name="DescripcionSegmento"
                              class="form-control" rows="3"
                              maxlength="255" required></textarea>
                </div>

                <div class="mb-3">
                    <label for="Criterio" class="form-label">
                        Criterio de clasificación
                    </label>
                    <input id="Criterio" name="Criterio"
                           class="form-control" maxlength="100"
                           placeholder="Ej.: Frecuencia de compra"
                           required />
                </div>

                <div class="mb-3">
                    <label for="Estado" class="form-label">
                        Estado
                    </label>
                    <select id="Estado" name="Estado"
                            class="form-select" required>
                        <option value="1">Activo</option>
                        <option value="0">Inactivo</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label for="ClienteClave" class="form-label">
                        Cliente asociado
                    </label>

                    <select id="ClienteClave" name="ClienteClave"
                            class="form-select" required>
                        <option value="">Seleccione un cliente</option>

                        
                        @foreach (var cliente in clientes)
                        {
                            var claveCliente = $"{cliente.IdCliente}|{cliente.PersonaCedula}|{cliente.PersonaTipoPersonaIdtipoPersona}";

                            <option value="@claveCliente"
                                    selected="@(claveCliente == (ViewBag.ClienteClaveSeleccionado as string))">
                                @cliente.Persona.Nombre
                                @cliente.Persona.Apellido1
                                @cliente.Persona.Apellido2
                                — Cédula: @cliente.PersonaCedula
                                — Cliente #@cliente.IdCliente
                            </option>
                        }

                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar segmento
                </button>

                <a asp-action="GestionSegmentos"
                   class="btn btn-outline-secondary ms-2">
                    Cancelar
                </a>
            </form>
        </div>
    </div>
</div>
