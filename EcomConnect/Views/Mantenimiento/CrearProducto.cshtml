@using EcomConnect.Models
@{
    ViewData["Title"] = "Registrar producto";
    var bodegas = ViewBag.Bodegas as List<Bodega> ?? new List<Bodega>();
}

<div class="container py-4">
    <h2>Registrar producto</h2>
    <p class="text-muted">Complete los datos del producto que desea registrar.</p>

    @if (!bodegas.Any())
    {
        <div class="alert alert-warning">
            Debe registrar una bodega antes de agregar productos.
        </div>

        <a asp-action="CrearBodega" class="btn btn-primary">Registrar bodega</a>
    }
    else
    {
        <form asp-controller="Mantenimiento"
              asp-action="CrearProducto"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="Nombre" class="form-label">Nombre</label>
                <input id="Nombre" name="Nombre" class="form-control"
                       maxlength="200" required />
            </div>

            <div class="mb-3">
                <label for="DescripcionProducto" class="form-label">Descripción</label>
                <textarea id="DescripcionProducto" name="DescripcionProducto"
                          class="form-control" maxlength="500"
                          rows="3" required></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="CantidadDisponible" class="form-label">Cantidad disponible</label>
                    <input type="number" id="CantidadDisponible"
                           name="CantidadDisponible" class="form-control"
                           min="0" value="0" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="PuntoReorden" class="form-label">Punto de reorden</label>
                    <input type="number" id="PuntoReorden" name="PuntoReorden"
                           class="form-control" min="0" value="0" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="BackOrder" class="form-label">¿Permite back order?</label>
                <select id="BackOrder" name="BackOrder" class="form-select" required>
                    <option value="0">No</option>
                    <option value="1">Sí</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="Precio" class="form-label">Precio unitario</label>
                <input type="number" id="Precio" name="Precio"
                       class="form-control" min="0" step="0.01"
                       value="0.00" required />
            </div>

            <div class="mb-3">
                <label for="BodegaIdBodega" class="form-label">Bodega</label>
                <select id="BodegaIdBodega" name="BodegaIdBodega"
                        class="form-select" required>
                    <option value="">Seleccione una bodega</option>
                    @foreach (var bodega in bodegas)
                    {
                        <option value="@bodega.IdBodega">@bodega.Nombre</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Registrar producto</button>

            <a asp-action="ProductosBodegas" class="btn btn-secondary">Cancelar</a>
        </form>
    }
</div>
