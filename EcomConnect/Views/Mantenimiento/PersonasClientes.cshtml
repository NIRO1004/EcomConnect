
@using EcomConnect.Models
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Mensaje"]
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["MensajeError"]
    </div>
}
@{
    ViewData["Title"] = "Personas y clientes";
    var personas = ViewBag.Personas as List<Persona> ?? new List<Persona>();
    var clientes = ViewBag.Clientes as List<Cliente> ?? new List<Cliente>();
}

<div class="container py-4">
    <h2>Personas y clientes</h2>
    <a asp-controller="Mantenimiento"
       asp-action="CrearCliente"
       class="btn btn-primary mb-3">
        <i class="bi bi-person-plus"></i> Crear cliente
    </a>
    <p class="text-muted">Consulta de registros almacenados en SQL Server.</p>

    <h4 class="mt-4">Personas</h4>

    @if (personas.Count == 0)
    {
        <p>No hay personas registradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Primer apellido</th>
                        <th>Segundo apellido</th>
                        <th>Fecha de nacimiento</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var persona in personas)
                    {
                        <tr>
                            <td>@persona.Cedula</td>
                            <td>@persona.Nombre</td>
                            <td>@persona.Apellido1</td>
                            <td>@persona.Apellido2</td>
                            <td>@persona.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h4 class="mt-4">Clientes</h4>

    @if (clientes.Count == 0)
    {
        <p>No hay clientes registrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha de alta</th>
                        <th>Fecha de baja</th>
                        <th>Método de pago</th>
                        <th>Calificación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in clientes)
                    {
                        <tr>
                            <td>@cliente.IdCliente</td>
                            <td>@cliente.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td>@(cliente.FechaBaja?.ToString("dd/MM/yyyy") ?? "Activo")</td>
                            <td>@cliente.MetodoPago</td>
                            <td>@cliente.Calificacion</td>

                            
                            <td>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <a asp-controller="Mantenimiento"
                                       asp-action="EditarCliente"
                                       asp-route-idCliente="@cliente.IdCliente"
                                       asp-route-cedula="@cliente.PersonaCedula"
                                       asp-route-tipoPersonaId="@cliente.PersonaTipoPersonaIdtipoPersona"
                                       class="btn btn-info btn-sm text-white">Editar</a>

                                    <form asp-controller="Mantenimiento"
                                          asp-action="EliminarCliente"
                                          method="post"
                                          class="m-0"
                                          onsubmit="return confirm('¿Deseas eliminar este cliente?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="idCliente"
                                               value="@cliente.IdCliente" />
                                        <input type="hidden" name="cedula"
                                               value="@cliente.PersonaCedula" />
                                        <input type="hidden" name="tipoPersonaId"
                                               value="@cliente.PersonaTipoPersonaIdtipoPersona" />

                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Mantenimiento"
       asp-action="Index"
       class="btn btn-outline-primary mt-3">
        Volver a mantenimiento
    </a>
</div>
