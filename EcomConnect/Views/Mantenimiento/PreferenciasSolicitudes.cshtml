@using EcomConnect.Models

@{
    ViewData["Title"] = "Preferencias y solicitudes";

    var preferencias = ViewBag.Preferencias as List<Preferencium>
        ?? new List<Preferencium>();

    var solicitudes = ViewBag.QuejasSolicitudes as List<QuejaSolicitud>
        ?? new List<QuejaSolicitud>();
}

<div class="container py-4">

    <h2>Preferencias y solicitudes</h2>

    <p class="text-muted">
        Consulta de preferencias de clientes y solicitudes registradas.
    </p>

    <!-- Preferencias de clientes -->
    <h4 class="mt-4">Preferencias de clientes</h4>

    <div class="table-responsive mb-4">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>ID del cliente</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (preferencias.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            No hay preferencias registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var preferencia in preferencias)
                    {
                        <tr>
                            <td>@preferencia.IdPreferencia</td>
                            <td>@preferencia.Tipo</td>
                            <td>@preferencia.DescripcionPreferencia</td>
                            <td>@preferencia.ClienteIdCliente</td>
                            <td>
                                <span class="text-muted">Sin acciones</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Quejas y solicitudes -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 mb-3">

        <h4 class="mb-0">Quejas y solicitudes</h4>

        <a asp-controller="Mantenimiento"
           asp-action="CrearQuejaSolicitud"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Registrar queja o solicitud
        </a>

    </div>

    <div class="table-responsive mb-4">
        <table class="table table-striped table-bordered align-middle">

            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Fecha de registro</th>
                    <th>Estado</th>
                    <th>Respuesta</th>
                    <th>ID del cliente</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (solicitudes.Count == 0)
                {
                    <tr>
                        <td colspan="8">
                            No hay quejas o solicitudes registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var solicitud in solicitudes)
                    {
                        <tr>
                            <td>@solicitud.IdQuejaSolicitud</td>
                            <td>@solicitud.Tipo</td>
                            <td>@solicitud.DescripcionQuejasolicitud</td>
                            <td>
                                @solicitud.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @(System.Text.Encoding.UTF8
                                    .GetString(solicitud.Estado).Trim() switch
                                {
                                    "P" => "Pendiente",
                                    "E" => "En proceso",
                                    "R" => "Resuelto",
                                    _ => "Sin estado definido"
                                })
                            </td>
                            <td>@solicitud.Respuesta</td>
                            <td>@solicitud.ClienteIdCliente</td>
                            <td>
                                <a asp-controller="Mantenimiento"
                                   asp-action="EditarQuejaSolicitud"
                                   asp-route-id="@solicitud.IdQuejaSolicitud"
                                   class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

    <a asp-controller="Mantenimiento"
       asp-action="Index"
       class="btn btn-outline-primary">
        ← Volver a mantenimiento
    </a>

</div>
