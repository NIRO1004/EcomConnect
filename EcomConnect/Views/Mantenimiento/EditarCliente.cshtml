@model EcomConnect.Models.Cliente
@using EcomConnect.Models

@{
    ViewData["Title"] = "Editar cliente";

    var generos = ViewBag.Generos as List<CatalogoGenero>
        ?? new List<CatalogoGenero>();

    var persona = Model.Persona;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Editar cliente</h2>

        <a asp-action="PersonasClientes"
           class="btn btn-secondary">
            Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditarCliente" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="idCliente"
                       value="@Model.IdCliente" />

                <input type="hidden" name="cedula"
                       value="@Model.PersonaCedula" />

                <input type="hidden" name="tipoPersonaId"
                       value="@Model.PersonaTipoPersonaIdtipoPersona" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <h5 class="mb-3">Datos personales</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cédula</label>
                        <input class="form-control"
                               value="@Model.PersonaCedula"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Nombre" class="form-label">Nombre</label>
                        <input id="Nombre" name="Nombre"
                               class="form-control" maxlength="30"
                               value="@persona.Nombre" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Apellido1" class="form-label">
                            Primer apellido
                        </label>
                        <input id="Apellido1" name="Apellido1"
                               class="form-control" maxlength="30"
                               value="@persona.Apellido1" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Apellido2" class="form-label">
                            Segundo apellido
                        </label>
                        <input id="Apellido2" name="Apellido2"
                               class="form-control" maxlength="30"
                               value="@persona.Apellido2" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="FechaNacimiento" class="form-label">
                            Fecha de nacimiento
                        </label>
                        <input id="FechaNacimiento"
                               name="FechaNacimiento"
                               type="date" class="form-control"
                               value="@persona.FechaNacimiento.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="CatalogoGeneroIdCatalogoGenero"
                               class="form-label">Género</label>

                        <select id="CatalogoGeneroIdCatalogoGenero"
                                name="CatalogoGeneroIdCatalogoGenero"
                                class="form-select" required>
                            @foreach (var genero in generos)
                            {
                                <option value="@genero.IdCatalogoGenero"
                                        selected="@(genero.IdCatalogoGenero ==
                                        persona.CatalogoGeneroIdCatalogoGenero)">
                                    @genero.DescripcionGenero
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <hr />

                <h5 class="mb-3">Datos del cliente</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="MetodoPago" class="form-label">
                            Método de pago
                        </label>
                        <input id="MetodoPago" name="MetodoPago"
                               class="form-control" maxlength="50"
                               value="@Model.MetodoPago" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Calificacion" class="form-label">
                            Calificación
                        </label>
                        <input id="Calificacion" name="Calificacion"
                               type="number" class="form-control"
                               min="0" max="9.99" step="0.01"
                               value="@Model.Calificacion.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar cambios
                </button>
            </form>
        </div>
    </div>
</div>
