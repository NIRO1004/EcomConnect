@using EcomConnect.Models

@{
    ViewData["Title"] = "Facturación y pagos";
    Layout = "_Layout";

    var facturas = ViewBag.Facturas as List<Factura> ?? new List<Factura>();
    var detalles = ViewBag.DetallesFactura as List<FacturaDetalle> ?? new List<FacturaDetalle>();
    var metodos = ViewBag.MetodosPago as List<MetodoPago> ?? new List<MetodoPago>();
}

<div class="container py-4">
    <h2>Facturación y pagos</h2>
    <p class="text-muted">
        Consulta de facturas, detalles y métodos de pago registrados.
    </p>

    <h4 class="mt-4">Facturas registradas</h4>
    <div class="table-responsive tabla-scroll mb-4">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID de factura</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>ID del método de pago</th>
                </tr>
            </thead>
            <tbody>
                @if (facturas.Count == 0)
                {
                    <tr><td colspan="4">No hay facturas registradas.</td></tr>
                }
                else
                {
                    @foreach (var factura in facturas)
                    {
                        <tr>
                            <td>@factura.IdFactura</td>
                            <td>@factura.FechaFactura.ToString("dd/MM/yyyy")</td>
                            <td>@factura.Total.ToString("N2")</td>
                            <td>@factura.MetodoPagoIdMetodoPago</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h4 class="mt-4">Detalles de facturación</h4>
    <div class="table-responsive tabla-scroll mb-4">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID del detalle</th>
                    <th>ID de factura</th>
                    <th>ID del producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @if (detalles.Count == 0)
                {
                    <tr><td colspan="6">No hay detalles de facturación registrados.</td></tr>
                }
                else
                {
                    @foreach (var detalle in detalles)
                    {
                        <tr>
                            <td>@detalle.IdFacturaDetalle</td>
                            <td>@detalle.FacturaIdFactura</td>
                            <td>@detalle.ProductoIdProducto</td>
                            <td>@detalle.Cantidad</td>
                            <td>@detalle.PrecioUnitario.ToString("N2")</td>
                            <td>@detalle.SubTotal.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h4 class="mt-4">Métodos de pago</h4>
    <div class="table-responsive tabla-scroll mb-4">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
                @if (metodos.Count == 0)
                {
                    <tr><td colspan="3">No hay métodos de pago registrados.</td></tr>
                }
                else
                {
                    @foreach (var metodo in metodos)
                    {
                        <tr>
                            <td>@metodo.IdMetodoPago</td>
                            <td>@metodo.Nombre</td>
                            <td>@metodo.DescripcionMetodopago</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <a asp-controller="Mantenimiento"
       asp-action="Index"
       class="btn btn-outline-primary">
        Volver a mantenimiento
    </a>
</div>
