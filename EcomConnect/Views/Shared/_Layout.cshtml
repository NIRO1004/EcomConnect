<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcomConnect</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcomConnect.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <span>
                <strong>EcomConnect<span> Solutions</span></strong>
                <small>Sistema de pedidos de paquetería</small>
            </span>
        </a>

        <div class="user-profile">
            <span class="notification">♧</span>
            <span>
                <strong>@ViewData["UserName"]</strong>
                <small>@ViewData["UserEmail"]</small>
            </span>
            <span class="chevron">▼</span>
        </div>

    </header>

    <div class="app-container">
        <aside class="sidebar">
            <nav>
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <span>Inicio</span> 
                </a>
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <span>Pedidos</span>
                </a>
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <span>Envíos</span>
                </a>
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <span>Perfil</span>
                </a>
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <span>Configuración</span>
                </a>
            </nav>
        </aside>

        <main class="content">
            @RenderBody()
        </main>

    </div>
    <footer class="site-footer">
        <p>© @DateTime.Now.Year EcomConnect Solutions.</p>
        <p>Sistema de pedidos de paquetería</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
