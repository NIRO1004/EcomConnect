@{
    ViewData["Title"] = "Home Page";
}

<section class="welcome-banner">
    <div class="welcome-text">
        <h1>Bienvenido a EcomConnect</h1>
        <p>
            EcomConnect Solutions te permite gestionar pedidos, envios y mantenimiento de forma
            simple y organizada.
        </p>
    </div>

</section>

<section class="module-grid">

    <a href="#" class="module-card orders">
        <h2>Pedidos</h2>
        <p>Registra y consulta <br />los pedidos de paquetería.</p>
        <span class="card-arrow">→</span>
    </a>

    <a href="#" class="module-card orders">
        <h2>Envíos</h2>
        <p>Consultado el estado <br />de los envíos.</p>
        <span class="card-arrow">→</span>
    </a>

    <a href="#" class="module-card orders">
        <h2>Clientes</h2>
        <p>Administrar la información <br />de tus clientes.</p>
        <span class="card-arrow">→</span>
    </a>

    <a href="#" class="module-card orders">
        <h2>Mantenimiento</h2>
        <p>Gestiona el mantenimiento <br />de los vehículos.</p>
        <span class="card-arrow">→</span>
    </a>

</section>

<section class="info-panel">
    <div class="info-divider"></div>
    <div>
        <h2>Mantén el control de tu operación</h2>
        <p>
            Utiliza los módulos del sistema para registrar pedidos, 
            dar seguimiento a tus envíos y programar mantenimientos, 
            todo desde un solo lugar.
        </p>
    </div>
</section>
